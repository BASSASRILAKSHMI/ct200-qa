# Copy this file to .env (same folder) and fill in your own values.
# .env is in .gitignore: it is never committed. Never paste keys into code or chat.

# ---- SQLite: document tree, versions, selections ----
DATABASE_URL=sqlite:///./ct200.db
DEFAULT_DOCUMENT_NAME=CT-200 Manual

# ---- LLM: any OpenAI-compatible endpoint; Groq by default ----
# Get a free key at https://console.groq.com  (API Keys -> Create API Key)
GROQ_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
# models change: run scripts/check_setup.py to list what your key can use
LLM_MODEL=openai/gpt-oss-120b
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=60
# replies the validator may reject before the generation is stored as failed
LLM_MAX_CONTENT_ATTEMPTS=3
# retries for rate limits / timeouts / provider 5xx (inside one attempt)
LLM_MAX_TRANSPORT_RETRIES=3

# ---- MongoDB: generated test cases ----
# Atlas: Connect -> Drivers -> copy the mongodb+srv://... string, put your password in it.
# Leave empty to use the JSON-file store in ./generation_store instead.
MONGODB_URI=
MONGODB_DB=ct200_qa
GENERATION_STORE_DIR=./generation_store
